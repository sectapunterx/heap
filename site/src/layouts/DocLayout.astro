---
import Base from './Base.astro';
import { DOC_GROUPS } from '../data/docs';
import { url } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  current?: string;
  toc?: Array<{ slug: string; text: string }>;
}

const { title, description, current, toc = [] } = Astro.props;
---

<Base title={title} description={description} active="docs">
  <div class="docs wrap">
    <aside class="docs__side" aria-label="Documentation">
      <button type="button" class="docs__search" data-open-palette>
        <span>Search the docs</span>
        <kbd class="kbd kbd--sm">/</kbd>
      </button>
      {
        DOC_GROUPS.map((g) => (
          <nav class="docs__group" aria-label={g.title}>
            <span class="eyebrow">{g.title}</span>
            {g.docs.map((d) => (
              <a href={url(`docs/${d.slug}`)} aria-current={d.slug === current ? 'page' : undefined}>
                {d.label}
              </a>
            ))}
          </nav>
        ))
      }
    </aside>
    <div class="docs__main">
      <slot />
    </div>
    {
      toc.length > 0 && (
        <aside class="docs__toc" aria-label="On this page">
          <span class="eyebrow">On this page</span>
          {toc.map((h) => (
            <a href={`#${h.slug}`}>{h.text}</a>
          ))}
        </aside>
      )
    }
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr) 200px;
    gap: 48px;
    align-items: start;
    padding-top: 48px;
    padding-bottom: 88px;
  }

  .docs__side,
  .docs__toc {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    max-height: calc(100vh - var(--nav-h) - 48px);
    overflow-y: auto;
  }

  .docs__side {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .docs__search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    padding: 0 8px 0 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--panel);
    color: var(--text4);
    font-size: 14px;
    cursor: pointer;
  }

  .docs__group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .docs__group .eyebrow {
    padding: 0 10px 10px;
  }

  .docs__group a {
    padding: 7px 10px;
    border-radius: 7px;
    color: var(--text3);
    font-size: 14px;
    text-decoration: none;
  }

  .docs__group a:hover {
    color: var(--text);
  }

  .docs__group a[aria-current='page'] {
    background: var(--accent-soft);
    color: var(--text);
    font-weight: 500;
  }

  .docs__toc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 8px;
  }

  .docs__toc a {
    font-size: 13px;
    line-height: 1.4;
    color: var(--text3);
    text-decoration: none;
  }

  .docs__toc a:hover {
    color: var(--text);
  }

  @media (max-width: 1100px) {
    .docs {
      grid-template-columns: 210px minmax(0, 1fr);
    }
    .docs__toc {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding-top: 24px;
    }
    .docs__side {
      position: static;
      max-height: none;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 16px;
    }
    .docs__search {
      display: none;
    }
    .docs__group {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    .docs__group .eyebrow {
      display: none;
    }
  }
</style>
