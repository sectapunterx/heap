---
import Icon from './Icon.astro';
import { assetsByOS, type Release } from '../lib/releases';
import { url } from '../lib/site';

interface Props {
  release: Release;
  class?: string;
}

const { release, class: className } = Astro.props;
const byOS = assetsByOS(release);
const primary = Object.fromEntries(
  Object.entries(byOS)
    .filter(([, list]) => list.length)
    .map(([os, list]) => [os, { url: list[0].url, name: list[0].name }]),
);
---

<a class:list={['btn btn--primary', className]} href={url('download')} data-os-cta={JSON.stringify(primary)}>
  <Icon name="download" size={18} />
  <span data-os-label>Download</span>
</a>

<script>
  import '../scripts/os-ui';
</script>
