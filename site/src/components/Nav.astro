---
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import { NAV, url, GITHUB_URL } from '../lib/site';

interface Props {
  active?: string;
}
const { active } = Astro.props;
---

<header class="nav">
  <div class="nav__inner">
    <a class="nav__brand" href={url()} aria-label="heap. — home">
      <Mark size={26} />
      <span class="wordmark">heap<span class="dot">.</span></span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={url(item.href)} aria-current={item.id === active ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <button type="button" class="nav__search" data-open-palette aria-label="Search the site (Ctrl K)">
        <Icon name="search" size={15} />
        <span class="nav__search-label">Search</span>
        <kbd class="kbd kbd--sm">Ctrl K</kbd>
      </button>
      <button type="button" class="nav__icon" data-theme-toggle aria-label="Toggle light and dark theme">
        <Icon name="moon" size={16} class="icon-moon" />
        <Icon name="sun" size={16} class="icon-sun" />
      </button>
      <a class="nav__icon nav__github" href={GITHUB_URL} aria-label="heap. on GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5z"
          ></path></svg
        >
      </a>
      <a class="btn btn--primary btn--sm nav__download" href={url('download')}>Download</a>
      <button type="button" class="nav__icon nav__menu" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <div class="nav__sheet" id="mobile-menu" hidden>
    <nav aria-label="Main (mobile)">
      {
        NAV.map((item) => (
          <a href={url(item.href)} aria-current={item.id === active ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={url('download')}>Download</a>
      <a href={GITHUB_URL}>GitHub ↗</a>
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>('.nav__menu');
  const sheet = document.getElementById('mobile-menu');
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    if (sheet) sheet.hidden = !open;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('heap-theme', next);
      } catch {
        /* storage blocked — the choice lasts for this page only */
      }
      window.dispatchEvent(new CustomEvent('heap:theme', { detail: next }));
    });
  });

  document.querySelectorAll<HTMLElement>('[data-open-palette]').forEach((el) => {
    el.addEventListener('click', () => window.dispatchEvent(new CustomEvent('heap:palette')));
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom: 1px solid var(--hair);
  }

  .nav__inner {
    max-width: calc(1320px + 2 * var(--gut));
    margin: 0 auto;
    height: var(--nav-h);
    padding: 0 clamp(16px, 4vw, 56px);
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .wordmark {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .dot {
    color: var(--accent);
  }

  .nav__links {
    display: flex;
    gap: 2px;
    flex-grow: 1;
  }

  .nav__links a,
  .nav__sheet a {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    border-radius: 8px;
    color: var(--text3);
    font-size: 14px;
    text-decoration: none;
  }

  .nav__links a:hover {
    color: var(--text);
  }

  .nav__links a[aria-current='page'],
  .nav__sheet a[aria-current='page'] {
    color: var(--text);
    background: var(--panel2);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .nav__search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 8px 0 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--panel);
    color: var(--text4);
    font-size: 14px;
    cursor: pointer;
  }

  .nav__icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: transparent;
    color: var(--text2);
    cursor: pointer;
  }

  .nav__icon:hover {
    color: var(--text);
  }

  /* The button shows what it switches to: a sun in the dark, a moon in the light. */
  :global([data-theme='light'] .icon-sun),
  :global(:root:not([data-theme='light']) .icon-moon) {
    display: none;
  }

  .nav__menu {
    display: none;
  }

  .nav__sheet {
    border-top: 1px solid var(--hair);
    padding: 8px 16px 16px;
  }

  .nav__sheet nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
  }

  .nav__sheet a {
    height: 44px;
    font-size: 15px;
  }

  @media (max-width: 1100px) {
    .nav__search-label,
    .nav__search .kbd {
      display: none;
    }
    .nav__search {
      width: 36px;
      padding: 0;
      justify-content: center;
    }
  }

  @media (max-width: 900px) {
    .nav__links,
    .nav__github,
    .nav__search {
      display: none;
    }
    .nav__menu {
      display: flex;
      width: 44px;
      height: 44px;
    }
    .nav__actions .nav__icon[data-theme-toggle] {
      width: 44px;
      height: 44px;
    }
  }

  @media (max-width: 420px) {
    .nav__download {
      display: none;
    }
  }
</style>
