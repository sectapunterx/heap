---
import Mark from './Mark.astro';
import { url, GITHUB_URL, ISSUES_URL } from '../lib/site';
import { FEATURE_AREAS } from '../data/features';
import { getLatestRelease } from '../lib/github';
import { versionOf } from '../lib/releases';

const latest = await getLatestRelease();
const cols = [
  {
    title: 'Product',
    links: [
      ...FEATURE_AREAS.map((a) => ({ label: a.label, href: url(`features/${a.slug}`) })),
      { label: 'Try it in the browser', href: url('demo') },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Your first day', href: url('docs/tutorial') },
      { label: 'Keyboard reference', href: url('docs/hotkeys') },
      { label: 'Integrations', href: url('docs/integrations') },
      { label: 'Data & backups', href: url('docs/data') },
      { label: 'Compare', href: url('compare') },
      { label: 'Privacy', href: url('privacy') },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'Download', href: url('download') },
      { label: 'Changelog', href: url('changelog') },
      { label: 'Source on GitHub', href: GITHUB_URL },
      { label: 'Report an issue', href: ISSUES_URL },
      { label: 'Brand', href: url('brand/') },
    ],
  },
];
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__intro">
        <a class="footer__brand" href={url()}>
          <Mark size={26} />
          <span>heap<span class="dot">.</span></span>
        </a>
        <p class="footer__tagline">Work, in one place.</p>
        <p class="footer__note">
          No accounts, no servers, no telemetry — and this site runs no trackers either. Fonts are served from here.
        </p>
      </div>
      {
        cols.map((c) => (
          <nav class="footer__col" aria-label={c.title}>
            <span class="eyebrow">{c.title}</span>
            {c.links.map((l) => (
              <a href={l.href}>{l.label}</a>
            ))}
          </nav>
        ))
      }
    </div>
    <div class="footer__bottom mono">
      <span>MIT license · v{versionOf(latest.tag)} · Qt 6 / C++20</span>
      <span>Windows · macOS · Linux</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: auto;
    padding: 64px 0 32px;
    background: var(--bg2);
    border-top: 1px solid var(--hair);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 32px;
  }

  .footer__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .footer__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .dot {
    color: var(--accent);
  }

  .footer__tagline {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: 22px;
  }

  .footer__note {
    margin: 0;
    max-width: 360px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text3);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer__col a {
    color: var(--text2);
    font-size: 14px;
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--text);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--hair);
    font-size: 12px;
    color: var(--text4);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__intro {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
