---
import { FEATURE_AREAS } from '../data/features';
import { url } from '../lib/site';

interface Props {
  current?: string;
}
const { current } = Astro.props;
---

<nav class="segmented area-nav" aria-label="Feature areas">
  {
    FEATURE_AREAS.map((a) => (
      <a href={url(`features/${a.slug}`)} aria-current={a.slug === current ? 'page' : undefined}>
        <span class="num">{a.num}</span>
        {a.label}
      </a>
    ))
  }
</nav>

<style>
  .area-nav {
    align-self: flex-start;
    max-width: 100%;
    overflow-x: auto;
    flex-wrap: nowrap;
  }
</style>
