---
// The home page, one per language. Copy: src/data/i18n.ts. Behaviour: src/scripts/landing.ts.
import Page from '../layouts/Page.astro';
import Screen from './Screen.astro';
import { copy, dataPaths, trackers, type Lang } from '../data/i18n';
import stateExample from '../data/state-example.json';
import { getLatestRelease } from '../lib/github';
import { assetsByOS, megabytes, primaryAssets, versionOf } from '../lib/releases';
import { OS_LABEL } from '../lib/os';
import { url } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang];
const downloadPage = url((lang === 'ru' ? 'ru/' : '') + 'download/');

const latest = await getLatestRelease();
const byOS = assetsByOS(latest);
const files = (['windows', 'macos', 'linux'] as const).flatMap((os) => byOS[os].map((a) => ({ ...a, osLabel: OS_LABEL[os] })));

type Crop = [number, number, number];
const shots: { img: string; crop: Crop }[] = [
  { img: 'H2-Today', crop: [210, 0, 1230] },
  { img: 'H2-Calendar', crop: [222, 0, 1218] },
  { img: 'X-Capture', crop: [30, 130, 1060] },
  { img: 'H2-Task', crop: [220, 0, 1180] },
  { img: 'H2-Knowledge', crop: [214, 0, 1210] },
];
const day = t.day.moments.map((m, i) => ({ ...m, ...shots[i] }));

// The keys of each card and the key codes that light it up (scripts/landing.ts).
const keyCaps: { k: string[]; codes: string }[] = [
  { k: ['j', 'k'], codes: 'KeyJ KeyK' },
  { k: ['d'], codes: 'KeyD' },
  { k: ['s'], codes: 'KeyS' },
  { k: ['Ctrl', '1–3'], codes: 'ctrl+Digit1 ctrl+Digit2 ctrl+Digit3' },
  { k: ['g', 'b'], codes: 'KeyG KeyB' },
  { k: ['y', 'y'], codes: 'KeyY' },
  { k: ['Ctrl', 'K'], codes: 'ctrl+KeyK' },
  { k: ['Ctrl', 'Shift', 'Space'], codes: 'ctrl+shift+Space' },
  { k: ['?'], codes: 'shift+Slash' },
];
const keys = keyCaps.map((k, i) => ({ ...k, t: t.keys.cards[i][0], d: t.keys.cards[i][1] }));

// state.json example (generated by tools/state-example.mjs) with light syntax colouring
const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const stateHtml = esc(JSON.stringify(stateExample.state, null, 2))
  .replace(/: "…"/g, ': [ … ]')
  .replace(/"…"/g, '…')
  .replace(/("[^"]+")(:)/g, '<span class="tk">$1</span>$2')
  .replace(/: ("[^"]*")/g, ': <span class="ts">$1</span>')
  .replace(/: (\d+)/g, ': <span class="tn">$1</span>');

const name = (i: number) => t.sections[i];
---

<Page
  lang={lang}
  path=""
  title={t.htmlTitle}
  description={t.description}
  home
  downloadHref={downloadPage}
  primary={JSON.stringify(primaryAssets(latest))}
>
  <!-- 1. hero -->
  <section class="hero" id="top" data-name={name(0)}>
    <div class="hero-copy">
      <h1 class="display lines" lang="en">
        <span><span>Quiet</span></span>
        <span><span>by default<span class="dot">.</span></span></span>
      </h1>
      <p class="sub fade">{t.hero.sub}</p>
      <div class="cta fade">
        <a class="btn solid dl" href={downloadPage} data-os-cta><span class="dl-label" data-app>{t.downloadApp}</span></a>
        <a class="btn ghost" href="#try" data-scroll="#try">{t.hero.try}</a>
      </div>
      <p class="facts fade">{t.hero.facts[0]} <i></i> {t.hero.facts[1]} <i></i> {t.hero.facts[2]}</p>
    </div>
    <figure class="hero-shot">
      <Screen name="H2-Today" lang={lang} label={t.hero.shot} />
    </figure>
  </section>

  <!-- 2. noise → calm -->
  <section class="noise" id="noise" data-name={name(1)}>
    <div class="noise-stage">
      <div class="noise-copy">
        <h2 class="h2 n-a">{t.noise.a}</h2>
        <h2 class="h2 n-b" set:html={t.noise.b} />
        <p class="muted n-a">{t.noise.pa}</p>
        <p class="muted n-b">{t.noise.pb}</p>
      </div>
      <div class="noise-field" aria-hidden="true">
        {t.noise.pings.map(([src, msg], i) => <div class="ping" style={`--i:${i}`}><b>{src}</b><span>{msg}</span><em></em></div>)}
        <div class="calm">
          <p class="calm-head">{t.noise.calmHead} <span>{t.noise.calmFacts}</span></p>
          {t.noise.rows.map(([ic, title, meta]) => <div class="row"><span class={`ic ${ic}`}></span>{title}<span class="meta mono">{meta}</span></div>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. live demo -->
  <section class="try" id="try" data-name={name(2)}>
    <div class="head">
      <p class="kicker">{t.demo.kicker}</p>
      <h2 class="h2 reveal">{t.demo.h}</h2>
      <p class="muted reveal">{t.demo.p}</p>
    </div>
    <div class="demo reveal" tabindex="-1">
      <div class="demo-top">
        <span class="demo-title">{t.demo.title}</span>
        <span class="demo-facts mono"></span>
      </div>
      <label class="cap">
        <span class="sr">{t.demo.input}</span>
        <input class="cap-in" type="text" autocomplete="off" spellcheck="false" placeholder={t.demo.placeholder} />
        <kbd>Enter</kbd>
      </label>
      <div class="chips" aria-live="polite"></div>
      <ul class="list"></ul>
      <div class="empty" hidden>
        <p class="empty-h">{t.demo.emptyH}</p>
        <p class="muted empty-s"></p>
        <a class="btn solid sm dl" href={downloadPage}><span class="dl-label">{t.demo.emptyCta}</span></a>
      </div>
      <p class="demo-hint mono">{t.demo.hint}</p>
    </div>
  </section>

  <!-- 4. a day -->
  <section class="day" id="day" data-name={name(3)}>
    <div class="day-pin">
      <div class="day-left">
        <p class="kicker">{t.day.kicker}</p>
        <p class="clock mono" aria-hidden="true">09:00</p>
        <ol class="moments">
          {
            day.map((m, i) => (
              <li class:list={{ on: i === 0 }}>
                <span class="mono t">{m.t}</span>
                <div>
                  <h3>{m.h}</h3>
                  <p>{m.p}</p>
                </div>
                <Screen name={m.img} lang={lang} label={m.h} crop={m.crop} class="m-img" />
              </li>
            ))
          }
        </ol>
      </div>
      <div class="day-right" aria-hidden="true">
        {day.map((m, i) => <Screen name={m.img} lang={lang} label={m.h} crop={m.crop} class={i === 0 ? 'on' : ''} />)}
      </div>
    </div>
  </section>

  <!-- 5. git: the difference from Linear / Things / Todoist -->
  <section class="git" id="git" data-name={name(4)}>
    <div class="git-wrap">
      <div class="git-copy">
        <p class="kicker">{t.git.kicker}</p>
        <h2 class="h2 reveal">{t.git.h}</h2>
        <p class="muted reveal">{t.git.p}</p>
        <button class="btn ghost sm reveal" type="button" data-git-run>{t.git.run}</button>
      </div>
      <div class="git-stage reveal" data-git>
        <div class="term">
          <div class="term-bar mono"><span>{t.git.repo}</span><span class="term-head" data-git-head data-branch={t.git.branch}>main</span></div>
          <pre class="mono"><span class="term-ps">$</span> <span data-git-cmd data-text={`git switch ${t.git.branch}`}></span><span class="term-caret" aria-hidden="true"></span>
<span class="term-out" data-git-out hidden>{`Switched to branch '${t.git.branch}'`}</span></pre>
        </div>
        <div class="gbar" data-git-bar>
          <span class="gbar-idle mono" data-git-off>main</span>
          <span class="gbar-on" data-git-on hidden>
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5 3v7.5M5 10.5a2 2 0 1 0 0 .01M11 5.5a2 2 0 1 0 0-.01M11 5.5c0 3-6 2-6 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
            {t.git.bar} <b class="mono">{t.git.id}</b> <span class="gbar-pr mono">{t.git.card.pr}</span>
          </span>
        </div>
        <div class="gcard" data-git-card role="group" aria-label={t.git.label}>
          <div class="gcard-title">{t.git.card.title}</div>
          <div class="gcard-meta"><span class="mono">{t.git.id}</span><span data-git-meta data-after={t.git.card.metaAfter}>{t.git.card.meta}</span></div>
          <div class="gcard-pr mono" data-git-on hidden>{t.git.card.pr}</div>
        </div>
        <p class="git-note" data-git-on hidden>{t.git.note}</p>
      </div>
    </div>
  </section>

  <!-- 6. keyboard -->
  <section class="keys" id="keys" data-name={name(5)}>
    <div class="head">
      <p class="kicker">{t.keys.kicker}</p>
      <h2 class="h2 reveal">{t.keys.h}</h2>
      <p class="muted reveal">{t.keys.p}</p>
    </div>
    <div class="keygrid">
      {
        keys.map((k) => (
          <button class="keycard reveal" type="button" data-codes={k.codes}>
            <span class="caps">{k.k.map((c) => <kbd>{c}</kbd>)}</span>
            <span class="kt">{k.t}</span>
            <span class="kd">{k.d}</span>
          </button>
        ))
      }
    </div>
    <p class="keys-note muted reveal">{t.keys.note}</p>
  </section>

  <!-- 7. style -->
  <section class="styles" id="styles" data-name={name(6)}>
    <div class="head">
      <p class="kicker">{t.styles.kicker}</p>
      <h2 class="h2 reveal">{t.styles.h}</h2>
      <p class="muted reveal">{t.styles.p}</p>
    </div>
    <div class="compare reveal" style="--pos:50%">
      <Screen name="Q-Board" lang={lang} label={t.styles.quiet} />
      <div class="compare-top"><Screen name="H2-Board" lang={lang} label={t.styles.bold} /></div>
      <span class="cmp-label l">{t.styles.l}</span><span class="cmp-label r">{t.styles.r}</span>
      <div class="handle" role="slider" tabindex="0" aria-label={t.styles.handle} aria-valuemin="0" aria-valuemax="100" aria-valuenow="50"><i></i></div>
    </div>
  </section>

  <!-- 8. built like a tool -->
  <section class="tool" id="tool" data-name={name(7)}>
    <div class="head">
      <p class="kicker">{t.tool.kicker}</p>
      <h2 class="h2 reveal">{t.tool.h}</h2>
    </div>
    <div class="tool-grid">
      {t.tool.cards.map(([big, h, p]) => <div class="tcard reveal"><p class="tool-big">{big}</p><h3>{h}</h3><p>{p}</p></div>)}
    </div>
  </section>

  <!-- 9. your data -->
  <section class="trust" id="trust" data-name={name(8)}>
    <div class="head">
      <p class="kicker">{t.trust.kicker}</p>
      <h2 class="h2 reveal">{t.trust.h}</h2>
    </div>
    <div class="trust-grid">
      {t.trust.cards.map(([h, p]) => <div class="tcard reveal" data-card={h}><h3>{h}</h3><p>{p}</p></div>)}
    </div>
    <div class="data-grid">
      <div class="data-where reveal">
        <h3>{t.trust.whereH}</h3>
        <dl class="paths">
          {dataPaths.map(([os, path]) => <div><dt>{os}</dt><dd class="mono">{path}</dd></div>)}
        </dl>
        {t.trust.whereP.map((p) => <p class="muted">{p}</p>)}
        <figure class="code" data-state-example>
          <figcaption class="mono"><span>{t.trust.example}</span><span>{t.trust.schema} {stateExample.state.schemaVersion}</span></figcaption>
          <pre class="mono" set:html={stateHtml} />
        </figure>
        <p class="muted">{t.trust.exampleNote}</p>
      </div>
      <div class="data-net reveal" data-net>
        <h3>{t.trust.netH}</h3>
        <p class="muted">{t.trust.netP}</p>
        <ol class="net">
          {t.trust.net.map(([h, when, p]) => <li><div class="net-h"><b>{h}</b><span class="mono">{when}</span></div><p>{p}</p></li>)}
        </ol>
      </div>
    </div>
    <div class="marquee" role="group" aria-label={t.trust.marquee}>
      <div class="mq-track">
        {[...trackers, ...trackers].map((tr, i) => <span class="chip" aria-hidden={i >= trackers.length ? 'true' : undefined}>{tr}</span>)}
      </div>
    </div>
    <p class="sign-in muted reveal">{t.trust.signIn}</p>
  </section>

  <!-- 10. faq -->
  <section class="faq" id="faq" data-name={name(9)}>
    <div class="head">
      <p class="kicker">{t.faq.kicker}</p>
      <h2 class="h2 reveal">{t.faq.h}</h2>
    </div>
    <div class="faq-list">
      {t.faq.items.map(([q, a]) => <details class="reveal"><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <!-- 11. download -->
  <section class="get" id="get" data-name={name(10)}>
    <h2 class="display reveal">{t.get.h}</h2>
    <p class="lede reveal">{t.get.p}</p>
    <div class="cta reveal">
      <a class="btn solid lg dl" href={downloadPage} data-os-cta><span class="dl-label" data-app>{t.downloadApp}</span></a>
    </div>
    <ul class="files reveal" data-files>
      {
        files.map((f) => (
          <li>
            <a href={f.url} data-os={f.os}>
              <span class="f-os">{f.osLabel}</span>
              <span class="f-kind">{t.kinds[f.kind]}</span>
              <span class="mono f-ext">{f.name.slice(f.name.lastIndexOf('.'))}</span>
              <span class="mono f-mb">{megabytes(f.size)} {t.get.mb}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="files-note reveal">{t.get.filesNote.replace('{v}', versionOf(latest.tag))} <a href={downloadPage}>{t.get.more}</a></p>
  </section>

  <aside slot="after" class="dock" aria-label={t.dock.label}>
    <div class="dock-progress"><i></i></div>
    <button class="dock-where" type="button" aria-label={t.dock.next}>
      <span class="mono dock-n">01</span><span class="dock-name">{t.sections[0]}</span><span class="dock-next" aria-hidden="true">↓</span>
    </button>
    <a class="btn solid sm dl" href={downloadPage}><span class="dl-label">{t.download}</span></a>
  </aside>

  <script>
    import '../scripts/landing.ts';
  </script>
</Page>
