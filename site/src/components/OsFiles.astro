---
import { assetsByOS, formatSize, type Release } from '../lib/releases';
import { OS_LABEL, type DesktopOS } from '../lib/os';

interface Props {
  release: Release;
  /** Extra hint under each OS's file list. */
  hints?: Partial<Record<DesktopOS, string>>;
}

const { release, hints = {} } = Astro.props;
const byOS = assetsByOS(release);
const order: DesktopOS[] = ['windows', 'macos', 'linux'];
const defaults: Record<DesktopOS, string> = {
  windows: 'Also on Scoop: scoop bucket add heap https://github.com/sectapunterx/heap',
  macos: 'Open the disk image and drag heap. into Applications.',
  linux: 'The .deb and tarball use your system Qt 6.4+; the AppImage brings its own.',
};
const uid = Math.random().toString(36).slice(2, 8);
---

<div class="osf" data-os-tabs>
  <div class="segmented" role="tablist" aria-label="Operating system">
    {
      order.map((os) => (
        <button
          type="button"
          role="tab"
          id={`osf-${uid}-${os}`}
          aria-controls={`osf-${uid}-${os}-panel`}
          aria-selected={os === 'windows' ? 'true' : 'false'}
          tabindex={os === 'windows' ? 0 : -1}
          data-os-tab={os}
        >
          {OS_LABEL[os]}
        </button>
      ))
    }
  </div>
  {
    order.map((os) => (
      <div class="osf__panel" role="tabpanel" id={`osf-${uid}-${os}-panel`} aria-labelledby={`osf-${uid}-${os}`} data-os-panel={os} hidden={os !== 'windows'}>
        {byOS[os].map((a, i) => (
          <a class:list={['osf__file', { 'osf__file--primary': i === 0 }]} href={a.url}>
            <span class="osf__text">
              <span class="osf__label">{a.label}</span>
              <span class="osf__name mono">{a.name}</span>
            </span>
            <span class="osf__size mono">{formatSize(a.size)}</span>
          </a>
        ))}
        <p class="osf__hint mono">{hints[os] ?? defaults[os]}</p>
      </div>
    ))
  }
</div>

<script>
  import '../scripts/os-ui';
</script>

<style>
  .osf {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .osf .segmented {
    align-self: flex-start;
  }

  .osf .segmented button {
    font: 500 14px var(--sans);
    letter-spacing: 0;
    text-transform: none;
  }

  .osf__panel {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .osf__file {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 10px 20px;
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
  }

  .osf__file:hover {
    color: var(--text);
    border-color: var(--text4);
  }

  .osf__file--primary {
    border-color: transparent;
    background: var(--btn);
    color: var(--btn-ink);
  }

  .osf__file--primary:hover {
    color: var(--btn-ink);
    filter: brightness(1.08);
  }

  .osf__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .osf__label {
    font-size: 15px;
    font-weight: 600;
  }

  .osf__name {
    overflow: hidden;
    font-size: 12px;
    opacity: 0.92;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .osf__size {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 13px;
    opacity: 0.92;
  }

  .osf__hint {
    margin: 2px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--text3);
    overflow-wrap: anywhere;
  }
</style>
