---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/site';

// Sources: docs/DATA.md, src/update/Updater.cpp (the release check),
// src/integrations/ (trackers, OAuth loopback, Mattermost).
const net = [
  {
    num: '01',
    title: 'Update check',
    when: 'on start · can be off',
    host: 'GET api.github.com/repos/sectapunterx/heap/releases/latest',
    body: 'Asks GitHub whether a newer release exists. It sends nothing about you or your data. Turn it off in Settings → About.',
  },
  {
    num: '02',
    title: 'Tracker sync',
    when: 'only if connected',
    host: 'the hosts you configure — github.com, your Jira site…',
    body: 'Pulls your issues. For GitHub, GitLab, Gitea and Forgejo it also closes or reopens an issue when you move its card. Manual, or on a timer you set.',
  },
  {
    num: '03',
    title: 'Browser sign-in',
    when: 'when you click Connect',
    host: 'your browser → the tracker → 127.0.0.1',
    body: 'Your browser opens the tracker’s own sign-in page, and heap. waits on a loopback port for the reply. heap. never sees your password.',
  },
  {
    num: '04',
    title: 'Mattermost people',
    when: 'only if connected',
    host: 'your Mattermost server',
    body: 'Reads the people you talk to, to offer them as contacts and @handles. Nothing is posted.',
  },
];
---

<Base title="Privacy" description="heap. keeps your work in one local file. Every place it stores data and every request it can make — there are only four." active="privacy">
  <section class="section">
    <div class="wrap stack" style="gap: 24px">
      <span class="eyebrow">Privacy · local-first</span>
      <h1 class="h1" style="max-width: 980px">Your work stays on your machine. Here is exactly how.</h1>
      <p class="lead" style="max-width: 720px">No account, no server, no telemetry. This page lists every place heap. keeps your data and every request it can make — there are only four.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--narrow-left">
      <div class="stack">
        <h2 class="h2">Where it lives</h2>
        <p class="lead">
          All state is one human-readable file, <span class="code-inline">state.json</span>, in your platform’s application-data folder.
          Timestamped backups rotate into <span class="code-inline">backups/</span> beside it; you choose how many to keep.
        </p>
        <p class="lead"><span class="code-inline">--data-dir</span> or <span class="code-inline">HEAP_DATA_DIR</span> puts everything somewhere else for a run.</p>
      </div>
      <div class="stack">
        <dl class="paths">
          <div><dt>Linux</dt><dd class="mono">~/.local/share/heap/state.json</dd></div>
          <div><dt>macOS</dt><dd class="mono">~/Library/Application Support/heap/state.json</dd></div>
          <div><dt>Windows</dt><dd class="mono">%APPDATA%\heap\state.json</dd></div>
        </dl>
        <div class="trio">
          <div class="card mini"><strong>Tokens</strong><span>In the OS keychain, never in state.json. Without a keychain, a separate secrets.json with restricted permissions.</span></div>
          <div class="card mini"><strong>Backups</strong><span>Restore from Settings → Data; the current state is backed up first.</span></div>
          <div class="card mini"><strong>Logs</strong><span>Written to logs/ on your disk. Nothing is uploaded — not even crashes.</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <h2 class="h2" style="max-width: 640px">Everything that ever leaves your machine</h2>
        <p class="lead" style="max-width: 420px">The complete list. If it isn’t here, heap. doesn’t send it.</p>
      </div>
      <div class="net">
        {
          net.map((n) => (
            <article class="card net__item">
              <div class="net__head">
                <span class="mono net__num">{n.num}</span>
                <h3 class="h3" style="font-size: 18px">
                  {n.title}
                </h3>
                <span class="mono net__when">{n.when}</span>
              </div>
              <span class="mono net__host">{n.host}</span>
              <p>{n.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--narrow-left">
      <div class="stack">
        <h2 class="h2">Moving between machines</h2>
        <p class="lead">
          Export a profile to a <span class="code-inline">.todocpp.json</span> file and import it on the other side — importing only ever adds.
          Continuous sync through <em>your own</em> private git remote is on the roadmap.
        </p>
        <a class="link-arrow" href={url('docs/data')}>Data &amp; backups in the docs</a>
      </div>
      <div class="trio">
        <div class="card mini"><span class="mono tag">today</span><strong>Export / import a profile</strong><span>Content only — never your settings or other profiles.</span></div>
        <div class="card mini"><span class="mono tag">today</span><strong>Notes as Markdown</strong><span>A folder of .md files, readable by Obsidian or any editor.</span></div>
        <div class="card mini mini--dashed"><span class="mono tag tag--muted">roadmap</span><strong>Sync via your git remote</strong><span>One diff-friendly file per profile, history for free.</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="card site-note">
        <Icon name="shield" size={28} />
        <p>
          This website follows the same rule: no analytics, no cookies, no third-party requests. Fonts are served from here. The browser demo
          keeps its state in your browser’s local storage and nowhere else.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .paths {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .paths div {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding: 15px 20px;
    border-bottom: 1px solid var(--hair);
    font-size: 15px;
  }

  .paths div:last-child {
    border-bottom: 0;
  }

  .paths dt {
    color: var(--text3);
  }

  .paths dd {
    margin: 0;
    font-size: 14px;
    color: var(--text2);
    overflow-wrap: anywhere;
  }

  .trio {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .mini {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text3);
  }

  .mini strong {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
  }

  .mini--dashed {
    background: transparent;
    border-style: dashed;
  }

  .tag {
    font-size: 12px;
    color: var(--accent);
  }

  .tag--muted {
    color: var(--text4);
  }

  @media (max-width: 700px) {
    .trio {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .net {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .net__item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
  }

  .net__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
  }

  .net__num {
    font-size: 12px;
    color: var(--accent);
  }

  .net__when {
    margin-left: auto;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--panel2);
    font-size: 11px;
    color: var(--text3);
  }

  .net__host {
    font-size: 13px;
    color: var(--text2);
    overflow-wrap: anywhere;
  }

  .net__item p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text3);
  }

  @media (max-width: 900px) {
    .net {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .site-note {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 32px 40px;
    color: var(--accent);
  }

  .site-note :global(svg) {
    flex-shrink: 0;
  }

  .site-note p {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text2);
  }

  @media (max-width: 640px) {
    .site-note {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px;
    }
  }
</style>
