---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import DownloadButton from '../components/DownloadButton.astro';
import OsFiles from '../components/OsFiles.astro';
import HeroBoard from '../islands/HeroBoard';
import { FEATURE_AREAS, tagline } from '../data/features';
import { HIGHLIGHTS } from '../data/highlights';
import { SHOTS } from '../lib/shots';
import { getLatestRelease, getReleases } from '../lib/github';
import { versionOf } from '../lib/releases';
import { url } from '../lib/site';

const latest = await getLatestRelease();
const releases = await getReleases();
const badgeRelease = releases.find((r) => HIGHLIGHTS[r.tag]?.badge);

const tour = FEATURE_AREAS.map((a) => ({
  ...a,
  shot: a.sections.find((s) => s.shot)!,
  points: a.sections.flatMap((s) => s.points ?? []).slice(0, 3),
}));

const integrations = [
  ['GH', 'GitHub', 'write-back'],
  ['GL', 'GitLab', 'write-back'],
  ['Ji', 'Jira', 'browser sign-in'],
  ['Tr', 'Trello', 'browser sign-in'],
  ['Gt', 'Gitea', 'write-back'],
  ['Fj', 'Forgejo', 'write-back'],
  ['Rm', 'Redmine', 'token'],
  ['Td', 'Todoist', 'browser sign-in'],
  ['As', 'Asana', 'browser sign-in'],
  ['Cu', 'ClickUp', 'browser sign-in'],
  ['Se', 'Sentry', 'browser sign-in'],
  ['Bb', 'Bitbucket', 'browser sign-in'],
  ['Mm', 'Mattermost', 'people & @handles'],
  ['+', 'Yours', 'one registry entry'],
];

const keys = [
  { label: 'Command palette', keys: ['Ctrl', 'K'] },
  { label: 'Quick-capture a task, from any app', keys: ['Ctrl', '⇧', 'Space'] },
  { label: 'Next / previous card', keys: ['J', 'K'] },
  { label: 'Move the card right', keys: ['⇧', 'L'] },
  { label: 'Calendar: today · go to date', keys: ['T', 'G'] },
  { label: 'Board · Timeline · Week · Month', keys: ['Ctrl', '1–4'] },
];

const faq = [
  ['Is heap. free?', 'Yes. It is open source under the MIT license — no paid tier, no trial, no account.'],
  ['Does it work offline?', 'Completely. heap. is a desktop app and your data is a local file. Only the tracker integrations you choose to connect need the network.'],
  ['Can I use it on more than one machine?', 'Today you export a profile on one machine and import it on the other, or copy state.json. Continuous sync through your own private git remote is on the roadmap.'],
  ['Can my team share a board?', 'Not in real time — heap. is a personal workspace. Shared work stays in your team’s tracker; heap. pulls those issues onto your board and closes or reopens them as you move cards.'],
  ['Can I bring my Obsidian notes?', 'Yes. Notes import from and export to a folder of .md files, with [[wiki-links]] intact.'],
  ['Which languages does the app speak?', 'English and Russian, switchable in Settings.'],
];
---

<Base>
  <!-- hero -->
  <section class="hero">
    <div class="wrap hero__inner">
      <a class="hero__badge" href={url('changelog')}>
        <span class="hero__ver mono">{versionOf(latest.tag)}</span>
        <span>{badgeRelease ? HIGHLIGHTS[badgeRelease.tag].badge : 'What’s new'}</span>
        <span aria-hidden="true" class="hero__arrow">→</span>
      </a>
      <h1 class="display hero__title">The whole job, in one native window.</h1>
      <p class="lead hero__lead">
        Board, calendar, docs and notes for engineers — a single Qt 6 binary that knows which git branch you’re on. Your work stays in one
        file on your own disk. No account, no server, no telemetry.
      </p>
      <div class="hero__ctas">
        <DownloadButton release={latest} />
        <a class="btn" href={url('demo')}>Try it in the browser <span aria-hidden="true" class="muted">→</span></a>
      </div>
      <p class="hero__fine mono">Free and open source · MIT · Windows, macOS, Linux</p>
      <div class="hero__app">
        <HeroBoard client:visible />
      </div>
      <p class="hero__caption">
        A live board — click or drag a card to move it. <a href={url('demo')}>Open the full sandbox</a> for the week, notes and
        <kbd class="kbd kbd--sm">Ctrl K</kbd>.
      </p>
    </div>
  </section>

  <!-- pillars -->
  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <h2 class="h2" style="max-width: 620px">Built like a tool, not a service.</h2>
        <p class="lead" style="max-width: 460px">Four decisions shape everything in heap. — and they are why it opens instantly and never asks you to log in.</p>
      </div>
      <div class="pillars">
        <article class="card pillar">
          <div class="pillar__visual mono">~/.local/share/heap/state.json</div>
          <h3 class="h3">Local-first</h3>
          <p>Everything lives in one JSON file on your disk, rotated into timestamped backups. Works on a plane. Nothing to sign up for.</p>
        </article>
        <article class="card pillar">
          <div class="pillar__visual mono"><Icon name="branch" size={14} /> APP-101-login-rate-limit</div>
          <h3 class="h3">Git-aware</h3>
          <p>Switch branches and the matching card lights up, with branch and PR state on the board. No manual linking.</p>
        </article>
        <article class="card pillar">
          <div class="pillar__visual">
            <kbd class="kbd">Ctrl</kbd><kbd class="kbd">K</kbd><span style="width: 6px"></span><kbd class="kbd">J</kbd><kbd class="kbd">K</kbd><kbd class="kbd">⇧ L</kbd>
          </div>
          <h3 class="h3">Keyboard-first</h3>
          <p>A command palette for everything, Vim-style card navigation, quick capture from any app. Every shortcut is rebindable.</p>
        </article>
        <article class="card pillar">
          <div class="pillar__visual">
            <span class="pillar__big">Qt 6</span>
            <span class="mono muted" style="font-size: 12px">C++20</span>
          </div>
          <h3 class="h3">Native &amp; light</h3>
          <p>A native binary, not a browser in disguise. Nothing runs in the background, and the Linux AppImage carries its own Qt.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- tour -->
  <section class="section" id="tour">
    <div class="wrap">
      <div class="stack" style="margin-bottom: 32px">
        <span class="eyebrow">One window, every surface</span>
        <h2 class="h2">Plan it, schedule it, write it down.</h2>
      </div>
      <div class="tour" data-tour>
        <div class="segmented tour__tabs" role="tablist" aria-label="Surfaces">
          {
            tour.map((a, i) => (
              <button type="button" role="tab" id={`tour-${a.slug}`} aria-controls={`tour-${a.slug}-panel`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tour-tab={a.slug}>
                <span class="num">{a.num}</span>
                {a.label}
              </button>
            ))
          }
        </div>
        {
          tour.map((a, i) => (
            <div class="tour__panel split split--narrow-left" role="tabpanel" id={`tour-${a.slug}-panel`} aria-labelledby={`tour-${a.slug}`} data-tour-panel={a.slug} hidden={i !== 0}>
              <div class="stack">
                <h3 class="tour__title">{tagline(a)}</h3>
                <p class="lead" style="font-size: 16px">{a.summary}</p>
                <ul class="dash-list">
                  {a.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
                <a class="link-arrow" href={url(`features/${a.slug}`)}>
                  Everything in {a.label}
                </a>
              </div>
              <div class="shot">
                <Picture src={SHOTS[a.shot.shot!]} alt={a.shot.shotAlt ?? ''} widths={[800, 1300, 1800]} sizes="(max-width: 900px) 100vw, 780px" formats={['avif']} fallbackFormat="webp" loading="lazy" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- git -->
  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <span class="eyebrow">Git-aware</span>
        <h2 class="h2">It already knows what you’re working on.</h2>
        <p class="lead">
          heap. watches your working copy. Check out a branch that carries a task id and the card is matched, decorated with the branch,
          and a focused-repo banner shows branch and PR state. No linking, no plugins, no copy-pasting ticket numbers.
        </p>
        <div><button type="button" class="btn btn--sm" data-git-run>Run the command</button></div>
      </div>
      <div class="stack" data-git>
        <div class="code-block">
          <div class="code-block__bar"><span>~/src/acme-web</span><span data-git-head>main</span></div>
          <pre><span class="tok-key">$</span> <span style="color: var(--text)">git switch -c APP-112-flaky-sync-test</span>
<span class="git-out" hidden>Switched to a new branch 'APP-112-flaky-sync-test'</span></pre>
        </div>
        <div class="card git-card">
          <div class="git-card__row">
            <span class="d-mono git-card__id">APP-112</span>
            <span class="git-card__chip mono">P2</span>
            <span class="git-card__branch mono" hidden><Icon name="branch" size={12} /> APP-112-flaky-sync-test</span>
          </div>
          <div class="git-card__title">Flaky test in the sync suite</div>
          <div class="muted" style="font-size: 14px">Fails one run in twenty on CI — timing around the rate-limit wait.</div>
          <div class="mono git-card__meta">To do · due in 3d</div>
        </div>
      </div>
    </div>
  </section>

  <!-- integrations -->
  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <div class="stack">
          <span class="eyebrow">Connect</span>
          <h2 class="h2" style="max-width: 640px">Your tracker’s issues, on your board.</h2>
        </div>
        <p class="lead" style="max-width: 460px">
          Sign in through the browser or paste a token. Tokens stay in the OS keychain, never in the data file. Close a card on a
          GitHub, GitLab, Gitea or Forgejo board and the issue closes too.
        </p>
      </div>
      <ul class="integrations">
        {
          integrations.map(([mono, name, note]) => (
            <li class="card integration">
              <span class="integration__mono mono" aria-hidden="true">{mono}</span>
              <span class="integration__name">{name}</span>
              <span class="integration__note mono">{note}</span>
            </li>
          ))
        }
      </ul>
      <p style="margin: 20px 0 0"><a class="link-arrow" href={url('features/connect')}>Connect a tracker in the browser demo</a></p>
    </div>
  </section>

  <!-- data -->
  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <span class="eyebrow">Local-first</span>
        <h2 class="h2">Your work is a file you own.</h2>
        <p class="lead">
          One human-readable <span class="code-inline">state.json</span>, timestamped backups beside it, profiles you can export one at a
          time. Notes go in and out as a folder of Markdown files that Obsidian opens as-is.
        </p>
        <dl class="paths">
          <div><dt>Linux</dt><dd class="mono">~/.local/share/heap/state.json</dd></div>
          <div><dt>macOS</dt><dd class="mono">~/Library/Application Support/heap/state.json</dd></div>
          <div><dt>Windows</dt><dd class="mono">%APPDATA%\heap\state.json</dd></div>
        </dl>
        <a class="link-arrow" href={url('privacy')}>What heap. does and doesn’t send</a>
      </div>
      <div class="stack">
        <figure class="code-block">
          <figcaption class="code-block__bar"><span>state.json</span><span>abridged</span></figcaption>
          <pre>{'{'}
  <span class="tok-key">"schemaVersion"</span>: 5,
  <span class="tok-key">"profiles"</span>: [{'{'}
    <span class="tok-key">"name"</span>: <span class="tok-str">"acme-web"</span>,
    <span class="tok-key">"tasks"</span>: [{'{'}
      <span class="tok-key">"id"</span>: <span class="tok-str">"APP-101"</span>,
      <span class="tok-key">"title"</span>: <span class="tok-str">"Login rate-limit bypass"</span>,
      <span class="tok-key">"deadline"</span>: <span class="tok-str">"2026-07-09"</span>
    {'}'}, …],
    <span class="tok-key">"notes"</span>: [ … ],
    <span class="tok-key">"people"</span>: [ … ]
  {'}'}]
{'}'}</pre>
        </figure>
        <div class="card callout">
          <Icon name="shield" size={20} />
          <p>
            The only request heap. makes on its own is an update check to <span class="code-inline">api.github.com</span> — and Settings
            has a switch for it. Trackers are contacted only after you connect them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- keyboard -->
  <section class="section">
    <div class="wrap split">
      <div class="stack">
        <span class="eyebrow">Keyboard-first</span>
        <h2 class="h2">Hands stay on the keys.</h2>
        <ul class="keys">
          {
            keys.map((k) => (
              <li>
                <span>{k.label}</span>
                <span class="keys__combo">
                  {k.keys.map((key) => (
                    <kbd class="kbd">{key}</kbd>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="muted" style="margin: 0; font-size: 14px">
          Try it here: <button type="button" class="inline-btn" data-open-palette><kbd class="kbd kbd--sm">Ctrl K</kbd></button> or
          <kbd class="kbd kbd--sm">/</kbd> searches this whole site.
        </p>
      </div>
      <div class="card palette-mock" aria-hidden="true">
        <div class="palette-mock__bar">
          <Icon name="search" size={16} />
          <span>rate lim<span class="caret"></span></span>
          <kbd class="kbd kbd--sm">Esc</kbd>
        </div>
        <div class="palette-mock__list">
          <div class="eyebrow">Tasks</div>
          <div class="pm-row pm-row--on"><span class="mono pm-id">APP-101</span><span>Login <b>rate-lim</b>it bypass</span><span class="mono pm-hint">In progress</span></div>
          <div class="pm-row"><span class="mono pm-id">APP-112</span><span>Flaky test around the <b>rate-lim</b>it wait</span></div>
          <div class="eyebrow">Notes</div>
          <div class="pm-row"><span>Standup notes</span><span class="muted">— shipped the <b>rate-lim</b>it fix for @Oleg</span></div>
          <div class="eyebrow">Commands</div>
          <div class="pm-row"><span>Move APP-101 to Review</span><span class="pm-hint"><kbd class="kbd kbd--sm">⇧</kbd> <kbd class="kbd kbd--sm">L</kbd></span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- download -->
  <section class="section" id="download">
    <div class="wrap">
      <div class="card get">
        <div class="stack">
          <h2 class="h2">Get heap.</h2>
          <p class="lead">One download, nothing else to install. The first run opens a short, skippable tour and a sample board.</p>
          <p class="mobile-note" data-mobile-note hidden>
            You’re on a phone — heap. is a desktop app for Windows, macOS and Linux.
            <button type="button" class="btn btn--sm" data-share-link={new URL(url('download'), Astro.site).href}>Send me the link</button>
          </p>
        </div>
        <OsFiles release={latest} />
      </div>
    </div>
  </section>

  <!-- faq -->
  <section class="section">
    <div class="wrap faq">
      <div class="stack">
        <span class="eyebrow">Questions</span>
        <h2 class="h2">Before you ask.</h2>
      </div>
      <div class="faq__list">
        {
          faq.map(([q, a], i) => (
            <details open={i === 0}>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  // Tour tabs
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((tour) => {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[data-tour-tab]')];
    const select = (slug: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.tourTab === slug;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      tour.querySelectorAll<HTMLElement>('[data-tour-panel]').forEach((p) => (p.hidden = p.dataset.tourPanel !== slug));
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.tourTab!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next.dataset.tourTab!);
      });
    });
  });

  // Git demo
  const run = document.querySelector<HTMLButtonElement>('[data-git-run]');
  const git = document.querySelector<HTMLElement>('[data-git]');
  run?.addEventListener('click', () => {
    if (!git) return;
    const on = !git.classList.contains('is-run');
    git.classList.toggle('is-run', on);
    git.querySelector<HTMLElement>('.git-out')!.hidden = !on;
    git.querySelector<HTMLElement>('.git-card__branch')!.hidden = !on;
    git.querySelector<HTMLElement>('[data-git-head]')!.textContent = on ? 'APP-112-flaky-sync-test' : 'main';
    git.querySelector<HTMLElement>('.git-card__meta')!.textContent = on ? 'To do · matched by id · focused repo acme-web' : 'To do · due in 3d';
    run.textContent = on ? 'Reset' : 'Run the command';
  });
</script>

<style>
  .hero {
    padding: clamp(56px, 9vw, 96px) 0 clamp(56px, 8vw, 88px);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 32px;
    padding: 3px 14px 3px 5px;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text2);
    font-size: 13px;
    text-decoration: none;
  }

  .hero__badge:hover {
    color: var(--text);
    border-color: var(--text4);
  }

  .hero__ver {
    padding: 3px 8px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 11px;
  }

  .hero__arrow {
    color: var(--text4);
  }

  .hero__title {
    max-width: 980px;
    margin-top: 32px;
  }

  .hero__lead {
    max-width: 720px;
    margin-top: 26px;
    font-size: clamp(17px, 1.6vw, 20px);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 38px;
  }

  .hero__ctas :global(.btn) {
    height: 52px;
  }

  .hero__fine {
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--text4);
  }

  .hero__app {
    width: 100%;
    max-width: 1200px;
    margin-top: 60px;
  }

  .hero__caption {
    margin: 20px 0 0;
    font-size: 14px;
    color: var(--text3);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
  }

  .pillar p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text3);
  }

  .pillar__visual {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    font-size: 12px;
    color: var(--accent);
    overflow-wrap: anywhere;
  }

  .pillar__big {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 36px;
    line-height: 1;
    color: var(--text);
  }

  @media (max-width: 1024px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .tour {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .tour__tabs {
    align-self: flex-start;
  }

  .tour__title {
    margin: 0;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .git-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  [data-git].is-run .git-card {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .git-card__row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .git-card__id {
    font: 400 12px var(--mono);
    color: var(--accent);
  }

  .git-card__chip {
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 11px;
    color: var(--p2);
    background: color-mix(in srgb, var(--p2) 14%, transparent);
  }

  .git-card__branch {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font-size: 11px;
    color: var(--accent);
  }

  .git-card__title {
    font-size: 16px;
    font-weight: 500;
  }

  .git-card__meta {
    font-size: 12px;
    color: var(--text4);
  }

  .integrations {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 12px;
  }

  .integration {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 112px;
    padding: 16px;
    border-radius: 12px;
  }

  .integration__mono {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: auto;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--panel2);
    font-size: 13px;
    color: var(--text2);
  }

  .integration__name {
    margin-top: 14px;
    font-size: 15px;
    font-weight: 500;
  }

  .integration__note {
    font-size: 11px;
    color: var(--text4);
  }

  @media (max-width: 1100px) {
    .integrations {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .integrations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .paths {
    margin: 4px 0 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .paths div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    padding: 13px 18px;
    border-bottom: 1px solid var(--hair);
    font-size: 14px;
  }

  .paths div:last-child {
    border-bottom: 0;
  }

  .paths dt {
    color: var(--text3);
  }

  .paths dd {
