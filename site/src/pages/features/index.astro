---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import AreaNav from '../../components/AreaNav.astro';
import { FEATURE_AREAS, tagline } from '../../data/features';
import { SHOTS } from '../../lib/shots';
import { url } from '../../lib/site';
---

<Base title="Features" description="Everything heap. does: a kanban board, a calendar, markdown notes and docs, tracker integrations and a keyboard-first flow." active="features">
  <section class="section">
    <div class="wrap stack" style="gap: 28px">
      <AreaNav />
      <h1 class="h1" style="max-width: 900px">Five surfaces, one window, one file.</h1>
      <p class="lead" style="max-width: 720px">
        Each part of heap. is useful alone. Together they share one palette, one search and one state file — so a task, the meeting about
        it and the note you took there are never three tabs apart.
      </p>
    </div>
  </section>
  <section class="section" style="padding-top: 0">
    <div class="wrap areas">
      {
        FEATURE_AREAS.map((a) => {
          const shot = a.sections.find((s) => s.shot);
          return (
            <a class="card area" href={url(`features/${a.slug}`)}>
              <span class="eyebrow">
                {a.num} · {a.label}
              </span>
              <span class="area__title">{tagline(a)}</span>
              <span class="area__text">{a.summary}</span>
              {shot?.shot && (
                <span class="area__shot">
                  <Picture src={SHOTS[shot.shot]} alt="" widths={[600, 900]} sizes="(max-width: 900px) 100vw, 560px" formats={['avif']} fallbackFormat="webp" loading="lazy" />
                </span>
              )}
            </a>
          );
        })
      }
      <a class="card area area--demo" href={url('demo')}>
        <span class="eyebrow">Try it</span>
        <span class="area__title">All of it, in your browser.</span>
        <span class="area__text">A sandbox with the board, the week, notes, the palette and a pretend git shell. Nothing to install.</span>
        <span class="link-arrow" style="margin-top: auto">Open the sandbox</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .areas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .area {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.12s ease;
  }

  .area:hover {
    color: var(--text);
    border-color: var(--text4);
  }

  .area__title {
    font-family: var(--serif);
    font-weight: 300;
    font-size: 30px;
    line-height: 1.15;
  }

  .area__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text3);
  }

  .area__shot {
    margin-top: 8px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }

  .area--demo {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  @media (max-width: 800px) {
    .areas {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
