---
// One 404 for both languages: GitHub Pages serves this file for any unknown path.
import Page from '../layouts/Page.astro';
import { copy } from '../data/i18n';
import { RELEASES_URL, url } from '../lib/site';

const en = copy.en.notFound;
const ru = copy.ru.notFound;
---

<Page lang="en" path="" title={en.title} description={en.p} downloadHref={RELEASES_URL + '/latest'} primary="{}">
  <section class="dlp" data-name="404">
    <p class="kicker">404</p>
    <h1 class="h2">{en.h}</h1>
    <p class="lede">{en.p}</p>
    <div class="cta" style="justify-content: flex-start">
      <a class="btn solid" href={url()}>{en.home}</a>
      <a class="btn ghost" href={url('download/')}>{copy.en.download}</a>
    </div>
    <p class="lede" lang="ru" style="margin-top: 48px">{ru.p} <a href={url('ru/')}>{ru.home}</a></p>
  </section>
</Page>
