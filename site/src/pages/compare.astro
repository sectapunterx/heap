---
import Base from '../layouts/Base.astro';
import { ISSUES_URL } from '../lib/site';

type Mark = 'yes' | 'no' | 'part' | null;
type Cell = [Mark, string?];

const tools = ['Jira', 'Trello', 'Notion', 'Obsidian'];
// Checked September 2026. Only claims that are easy to verify.
const rows: Array<[string, Cell, Cell, Cell, Cell, Cell]> = [
  ['Works fully offline', ['yes'], ['no'], ['no'], ['part', 'some pages'], ['yes']],
  ['No account needed', ['yes'], ['no'], ['no'], ['no'], ['yes']],
  ['Your data is a local file', ['yes', 'one JSON'], ['no'], ['no'], ['no'], ['yes', 'Markdown']],
  ['Native app, not a web view', ['yes', 'Qt 6'], ['no'], ['no'], ['no'], ['no']],
  ['Kanban board', ['yes'], ['yes'], ['yes'], ['yes'], ['part', 'plugin']],
  ['Calendar & time-blocking', ['yes'], ['part'], ['part'], ['part'], ['part', 'plugin']],
  ['Markdown notes, [[wiki-links]]', ['yes'], ['no'], ['no'], ['part'], ['yes']],
  ['Knows your current git branch', ['yes', 'local repo'], ['part', 'via dev tools'], ['no'], ['no'], ['no']],
  ['Open source', ['yes', 'MIT'], ['no'], ['no'], ['no'], ['no']],
  ['Real-time team collaboration', ['no'], ['yes'], ['yes'], ['yes'], ['part']],
  ['Mobile apps', ['no'], ['yes'], ['yes'], ['yes'], ['yes']],
  ['Price', [null, 'free'], [null, 'free tier + paid'], [null, 'free tier + paid'], [null, 'free tier + paid'], [null, 'free, paid add-ons']],
];
const SYMBOL = { yes: '●', no: '–', part: '◐' } as const;
const WORD = { yes: 'yes', no: 'no', part: 'partly' } as const;
---

<Base title="Compare" description="heap. next to Jira, Trello, Notion and Obsidian — offline, accounts, where your data lives, and the things heap. doesn’t do." active="compare">
  <section class="section">
    <div class="wrap split split--narrow-right" style="align-items: end">
      <div class="stack">
        <span class="eyebrow">Compare</span>
        <h1 class="h1">Where heap. fits — and where it doesn’t.</h1>
      </div>
      <p class="lead">heap. is a personal workspace, not a team tracker. Here it is next to the tools engineers usually juggle, including the rows it loses.</p>
    </div>
  </section>

  <section class="section" style="padding-top: 0; border-top: 0">
    <div class="wrap">
      <div class="table-scroll">
        <table class="cmp">
          <caption class="sr-only">heap. compared with Jira, Trello, Notion and Obsidian</caption>
          <thead>
            <tr>
              <td></td>
              <th scope="col" class="cmp__heap">heap<span style="color: var(--accent)">.</span></th>
              {tools.map((t) => <th scope="col">{t}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              rows.map(([label, ...cells]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {cells.map(([mark, note], i) => (
                    <td class:list={{ cmp__heap: i === 0 }}>
                      {mark && (
                        <span class={`cmp__mark cmp__mark--${mark}`} aria-hidden="true">
                          {SYMBOL[mark]}
                        </span>
                      )}
                      {mark && <span class="sr-only">{WORD[mark]}</span>}
                      {note && <span class="cmp__note mono">{note}</span>}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="legend">
        <span><span class="cmp__mark--yes">●</span> yes</span>
        <span><span class="cmp__mark--part">◐</span> partly, or with a plugin / add-on</span>
        <span><span class="cmp__mark--no">–</span> no</span>
        <span>Checked September 2026. Something out of date? <a href={ISSUES_URL}>Open an issue</a>.</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom: 36px">When heap. is not the right tool</h2>
      <div class="nots">
        <div class="card not">
          <h3 class="h3">Your team plans in one shared place</h3>
          <p>Keep the shared tracker. heap. is where you work through your part of it: it pulls your issues in, and closes or reopens them as you move cards.</p>
        </div>
        <div class="card not">
          <h3 class="h3">You plan from your phone</h3>
          <p>There is no mobile app. heap. runs on Windows, macOS and Linux desktops.</p>
        </div>
        <div class="card not">
          <h3 class="h3">You need it on every device, live</h3>
          <p>Moving between machines is export and import for now. Sync through your own private git remote is on the roadmap.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--narrow-left" style="align-items: center">
      <div class="stack">
        <h2 class="h2">Better together.</h2>
        <p class="lead">Most people keep their tracker and add heap. on top — the tracker stays the source of truth for the team, heap. becomes the desk you actually work at.</p>
      </div>
      <div class="flow">
        <div class="card flow__box"><span class="eyebrow">Team tracker</span><span>GitHub · Jira · GitLab…</span></div>
        <div class="flow__arrows mono">
          <span>issues →</span>
          <span class="muted">← open / closed, if you switch it on</span>
        </div>
        <div class="card flow__box flow__box--heap"><span class="eyebrow" style="color: var(--accent)">Your desk</span><span>heap. — board, week, notes</span></div>
      </div>
    </div>
  </section>
</Base>

<style>
  .table-scroll {
    position: relative;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 14px;
  }

  .cmp {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
    font-size: 15px;
  }

  .cmp thead {
    background: var(--panel);
  }

  .cmp thead th {
    height: 68px;
    padding: 0 12px;
    font-weight: 500;
    color: var(--text2);
    border-bottom: 1px solid var(--border);
  }

  .cmp thead td {
    border-bottom: 1px solid var(--border);
  }

  .cmp th.cmp__heap {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
  }

  .cmp tbody th {
    padding: 0 24px;
    height: 56px;
    text-align: left;
    font-weight: 400;
    color: var(--text2);
  }

  .cmp tbody tr + tr > * {
    border-top: 1px solid var(--hair);
  }

  .cmp td {
    width: 140px;
    padding: 8px 12px;
    text-align: center;
  }

  .cmp .cmp__heap {
    background: var(--accent-soft);
  }

  .cmp__mark {
    display: block;
    font-size: 16px;
  }

  .cmp__mark--yes {
    color: var(--yes);
  }

  .cmp__mark--no {
    color: var(--no);
  }

  .cmp__mark--part {
    color: var(--part);
  }

  .cmp__note {
    display: block;
    font-size: 12px;
    color: var(--text3);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 16px 0 0;
    font-size: 13px;
    color: var(--text4);
  }

  .nots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .not {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px;
  }

  .not p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text3);
  }

  @media (max-width: 900px) {
    .nots {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .flow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .flow__box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 230px;
    padding: 22px;
    font-size: 16px;
    font-weight: 500;
  }

  .flow__box--heap {
    border-color: var(--accent);
  }

  .flow__arrows {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
    color: var(--accent);
    text-align: center;
  }
</style>
