---
import Base from '../layouts/Base.astro';
import DemoApp from '../demo/DemoApp';
import { url } from '../lib/site';
---

<Base
  title="Try it in the browser"
  description="A sketch of heap. that runs in your browser: drag cards, plan the week, write linked notes, search with Ctrl+K and watch the board follow a git branch."
  active="demo"
  app
>
  <h1 class="sr-only">heap. in your browser — a sandbox</h1>
  <div class="strip">
    <div class="strip__inner">
      <span>
        <strong>Sandbox.</strong> A sketch of the app in your browser — it keeps its state in this browser’s local storage and nowhere else.
      </span>
      <a class="btn btn--primary btn--sm" href={url('download')}>Get the real thing</a>
    </div>
  </div>
  <DemoApp client:only="react" />
  <noscript>
    <p class="wrap" style="padding: 48px 0">
      The sandbox needs JavaScript. The <a href={url('features')}>feature pages</a> show the same things with screenshots.
    </p>
  </noscript>
</Base>

<style>
  .strip {
    border-bottom: 1px solid var(--hair);
    background: var(--bg2);
    font-size: 13px;
    color: var(--text3);
  }

  .strip__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    padding: 6px 16px;
  }

  .strip strong {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .strip__inner > span {
      font-size: 12px;
    }
  }
</style>
