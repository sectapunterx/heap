---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { DOCS, docBySlug } from '../../data/docs';
import { GITHUB_URL, url } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const meta = docBySlug(entry.id)!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const i = DOCS.findIndex((d) => d.slug === meta.slug);
const prev = DOCS[i - 1];
const next = DOCS[i + 1];
---

<DocLayout title={meta.label} description={meta.blurb} current={meta.slug} toc={toc}>
  <article class="prose">
    <Content />
  </article>
  <nav class="pager" aria-label="More docs">
    {prev ? <a href={url(`docs/${prev.slug}`)}>← {prev.label}</a> : <span />}
    <a class="pager__edit" href={`${GITHUB_URL}/blob/master/docs/${meta.file}`}>Edit on GitHub ↗</a>
    {next ? <a href={url(`docs/${next.slug}`)}>{next.label} →</a> : <span />}
  </nav>
</DocLayout>

<style>
  .prose {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text2);
    overflow-wrap: break-word;
  }

  .prose :global(h1) {
    margin: 0 0 20px;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .prose :global(h2) {
    margin: 44px 0 14px;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .prose :global(h3) {
    margin: 30px 0 10px;
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(table),
  .prose :global(pre) {
    margin: 0 0 18px;
  }

  .prose :global(li + li) {
    margin-top: 4px;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(:not(pre) > code) {
    padding: 1px 5px;
    border: 1px solid var(--hair);
    border-radius: 5px;
    background: var(--panel2);
    font-family: var(--mono);
    font-size: 0.86em;
    color: var(--text);
  }

  .prose :global(pre) {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow-x: auto;
    font: 400 13px/1.65 var(--mono);
  }

  .prose :global(pre.astro-code) {
    background-color: var(--code) !important;
  }

  :global([data-theme='dark']) .prose :global(.astro-code),
  :global([data-theme='dark']) .prose :global(.astro-code span) {
    color: var(--shiki-dark) !important;
  }

  .prose :global(blockquote) {
    padding: 10px 16px;
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: var(--accent-soft);
  }

  .prose :global(blockquote p:last-child) {
    margin: 0;
  }

  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 9px 14px;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--panel);
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(img) {
    border: 1px solid var(--border);
    border-radius: 10px;
    margin: 8px 0;
  }

  .prose :global(hr) {
    margin: 36px 0;
    border: 0;
    border-top: 1px solid var(--hair);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--hair);
    font-size: 15px;
  }

  .pager a {
    text-decoration: none;
  }

  .pager__edit {
    color: var(--text3);
  }
</style>
