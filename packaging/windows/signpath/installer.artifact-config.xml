<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration: "installer"
  Signs the finished Inno Setup installer.

  The CI step  actions/upload-artifact(path: installer/Output/heap-<tag>-windows-setup.exe)
  produces a ZIP whose ROOT holds the single setup .exe (name carries the tag,
  hence the wildcard).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" min-matches="1" max-matches="unbounded">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
